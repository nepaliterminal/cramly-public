{
  "buildCommand": "npm run build",
  "outputDirectory": "docs",
  "proxy": { "entrypoint": "proxy.js" },
  "rewrites": [
    { "source": "/", "destination": "/workspace/index.html" },
    { "source": "/admin", "destination": "/workspace/index.html" },
    { "source": "/admin/", "destination": "/workspace/index.html" }
  ]
}
